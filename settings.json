{
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "autoimport.filesToScan": "**/*.{js,ts,tsx}",
  "autoimport.showNotifications": true,
  "cSpell.userWords": [
    "Hono",
    "simplelightbox"
  ],
  "chatgpt.cliExecutable": "",
  "codesandbox.currentWorkspace": "ef1baae2-c419-4469-a4eb-73a6acfb0ece",
  "editor.accessibilitySupport": "off",
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "github.copilot.enable": {
    "*": false,
    "javascript": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "javascript.suggest.paths": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "npm.enableRunFromFolder": true,
  "npm.packageManager": "npm",
  "npm.runSilent": true,
  "path-intellisense.autoSlashAfterDirectory": true,
  "path-intellisense.extensionOnImport": true,
  "path-intellisense.mappings": {
    "/": "${workspaceRoot}"
  },
  "prettier.withNodeModules": true,
  "remote.SSH.remotePlatform": {
    "sandbox.97dp8s.csb": "linux"
  },
  "superdesign.aiModel": "gpt-4.1",
  "superdesign.aiModelProvider": "openai",
  "superdesign.openaiApiKey": "sk-xxxxxxxx",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.env.osx": {
    "CW_NEW_SESSION": "1",
    "Q_NEW_SESSION": "1"
  },
  "typescript.suggest.paths": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vsicons.dontShowNewVersionMessage": true,
  "window.zoomLevel": 3,
  "workbench.colorCustomizations": {},
  "workbench.editor.enablePreview": false,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.svg": "default"
  },
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.editor.empty.hint": "hidden",
  "extensions.ignoreRecommendations": true,
  "claudeCode.preferredLocation": "panel",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/bin/zsh",
      "args": [
        "-l"
      ]
    },
    "fish": {
      "path": "fish",
      "args": [
        "-l"
      ]
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.browser.openLocalhostLinks": false
}